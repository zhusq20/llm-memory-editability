  "limitations": [
    {
      "id": "equal_parameters_initialization",
      "finding": "C1/L1 and C2/L2 share parameter count but scaled_effective changes residual output initialization standard deviation with executed depth. These pairs do not isolate added computation alone; CD/L1/L2 at equal depth share the same residual standard deviation.",
      "consequence": "Restrict claims to the registered architectural/initialization recipe; do not label equal-parameter comparison a pure computation intervention."
    },
    {
      "id": "compute_proxy",
      "finding": "FLOPs count executed dense/attention matrix multiplies and factor-three backward; excludes optimizer updates, elementwise work, graph overhead and memory effects.",
      "consequence": "Equal executed depth matches this matmul estimate, not exact hardware time; common-budget earlier nodes have explicitly recorded residual budget gaps."
    },
    {
      "id": "recurrence_scope",
      "finding": "Changing model.repeats leaves trained parameters and residual initialization unchanged; extra repeats are inference distribution changes, not retrained depth variants.",
      "consequence": "Keep all scan counts and trained-repeat endpoint; no best-test repeat selection or length-generalization claim."
    },
    {
      "id": "historical_scan_provenance",
      "finding": "Initial development scans stored only script/checkpoint hashes; later v1 scans include full dependency/world/environment snapshots and native-repeat audits. All reviewed scans were independently recounted, and their native-repeat raw outputs match training predictions byte-for-byte. V2 adds environment mismatch rejection without numerical changes; v1 locks and artifacts remain intact.",
      "consequence": "Historical audit is supplemental evidence, not a retroactive pre-registration or claim that original scans contained the new metadata."
    },
    {
      "id": "teacher_forced_nll",
      "finding": "Stored NLL uses teacher-forced answer/EOS labels, while answer+EOS accuracy generates an answer and then uses that answer for EOS.",
      "consequence": "Do not describe NLL as likelihood of the freely generated sequence. No target leakage was found in answer or generated-EOS metrics."
    },
    {
      "id": "world_units_and_shortcuts",
      "finding": "Small fixed random graphs can admit relation-sequence shortcuts. Initialization repeats, queries and intervened layers remain nested within a world; conditional atom-correct or suffix-ambiguity subsets do not replace full results.",
      "consequence": "Development is one world; three confirmation worlds still support bounded controlled comparisons rather than a universal architecture law."
    },
    {
      "id": "mechanism_scope",
      "finding": "All donor paths follow the selected ID/OOD fact class, keep r1, exclude trained different-target counterfactual queries and use two-token prefixes. Both/full equality is warranted only at first execution; component mixtures later retain the recipient incoming residual.",
      "consequence": "A failed mixture does not establish absent information, and OOD intervention failure is not independently interpretable without atomic and native-counterfactual prerequisites."
    },
    {
      "id": "sensitivity_mechanism_plot_boundary",
      "finding": "The new mechanism report groups chart rows by architecture within a comparison recipe. If sensitivity mechanisms at multiple depths but the same architecture/phase/init scheme are later added, chart facets must also separate intended depth; CSV/JSON records already retain condition IDs.",
      "consequence": "Current development and confirmation five-arm mechanism matrices do not contain this ambiguity."
    }
  ],
